{
    "name": "kodvalley/improj-php-tool-phpstan",
    "description": "Pinned development tool for improj-php (kept apart from the library dependencies).",
    "type": "project",
    "license": "MIT",
    "require": {
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1"
    },
    "config": {
        "platform": { "php": "8.3.30" },
        "sort-packages": true,
        "allow-plugins": {},
        "audit": { "abandoned": "fail" }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
