{
    "name": "kodvalley/improj-php-tool-psalm",
    "description": "Pinned development tool for improj-php (kept apart from the library dependencies).",
    "type": "project",
    "license": "MIT",
    "require": {
        "vimeo/psalm": "^6"
    },
    "config": {
        "platform": { "php": "8.3.30" },
        "sort-packages": true,
        "allow-plugins": {},
        "audit": { "abandoned": "fail" }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
